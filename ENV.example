# Copy these into your hosting provider's secret/environment settings.
PORT=3000
NODE_ENV=production

# Owner bootstrap
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=replace-with-a-long-random-password

# Razorpay TEST keys first. Never put the secret in browser code.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=create-a-separate-random-webhook-secret
